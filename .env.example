# Все значения ниже совпадают с умолчаниями в src/config.py:
# если ваш стек на этих адресах, строки можно не менять.

# LLM (любой OpenAI-совместимый сервер, здесь KoboldCpp)
LLM_BASE_URL=http://localhost:5001/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3.5

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=MTS_support_v2

# Эмбеддер и реранкер (llama-server)
EMBED_URL=http://localhost:5002/embedding
RERANK_URL=http://127.0.0.1:5003/v1/rerank

# Langfuse (трейсинг)
LANGFUSE_SECRET_KEY="your-key"
LANGFUSE_PUBLIC_KEY="your-key"
LANGFUSE_BASE_URL="http://localhost:3000"

# GigaChat — только для разметки eval (tests/)

LANGFUSE_SECRET_KEY="your-key"
LANGFUSE_PUBLIC_KEY="your-key"
LANGFUSE_BASE_URL="http://localhost:3000"

GIGACHAT_CREDENTIALS="your-creds"
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=False
