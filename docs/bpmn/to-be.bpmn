<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="handmade" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Client" name="Клиент" />
    <bpmn:participant id="ContactCenter" name="Контакт-центр: первая линия" processRef="Process_ToBe" />
    <bpmn:messageFlow id="M1" name="Сообщение" sourceRef="Client" targetRef="Start" />
    <bpmn:messageFlow id="M2" name="Шаблон" sourceRef="Tmpl" targetRef="Client" />
    <bpmn:messageFlow id="M3" name="Ответ бота" sourceRef="Answer" targetRef="Client" />
    <bpmn:messageFlow id="M4" name="Уведомление" sourceRef="Notify" targetRef="Client" />
    <bpmn:messageFlow id="M5" name="Ответ оператора" sourceRef="Operator" targetRef="Client" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Bot" name="Бот SupportAgent">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tmpl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TmplEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AnsEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Оператор первой линии">
        <bpmn:flowNodeRef>Operator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Сообщение получено">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Triage" name="Определить тип и риски сообщения">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Route" name="Тип обращения?" default="F4">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Tmpl" name="Отправить шаблонный ответ">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="TmplEnd" name="Ответ дан">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Search" name="Найти фрагменты в базе знаний">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:property id="Property_Search" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Search">
        <bpmn:sourceRef>KB</bpmn:sourceRef>
        <bpmn:targetRef>Property_Search</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="KB" name="База знаний" />
    <bpmn:serviceTask id="Gen" name="Сгенерировать ответ со ссылками">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Guard" name="Ссылки [n] корректны?" default="F10">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Answer" name="Отправить ответ со списком статей-источников">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="AnsEnd" name="Ответ дан">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge" name="">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Notify" name="Сообщить клиенту о переводе на оператора">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Operator" name="Продолжить диалог с клиентом">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="OpEnd" name="Обращение у оператора">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Triage" />
    <bpmn:sequenceFlow id="F2" sourceRef="Triage" targetRef="Route" />
    <bpmn:sequenceFlow id="F3" name="Smalltalk или не по теме" sourceRef="Route" targetRef="Tmpl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">intent in (smalltalk, off_topic)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" name="Вопрос, просьба, жалоба" sourceRef="Route" targetRef="Search" />
    <bpmn:sequenceFlow id="F5" name="Угроза, self-harm или просьба об операторе" sourceRef="Route" targetRef="Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">threat in (violence, self_harm) or wants_operator</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="Tmpl" targetRef="TmplEnd" />
    <bpmn:sequenceFlow id="F7" sourceRef="Search" targetRef="Gen" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gen" targetRef="Guard" />
    <bpmn:sequenceFlow id="F9" name="да" sourceRef="Guard" targetRef="Answer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">guard passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" name="нет" sourceRef="Guard" targetRef="Merge" />
    <bpmn:sequenceFlow id="F11" sourceRef="Answer" targetRef="AnsEnd" />
    <bpmn:sequenceFlow id="F12" sourceRef="Merge" targetRef="Notify" />
    <bpmn:sequenceFlow id="F13" sourceRef="Notify" targetRef="Operator" />
    <bpmn:sequenceFlow id="F14" sourceRef="Operator" targetRef="OpEnd" />
    <bpmn:textAnnotation id="N1">
      <bpmn:text>Учитываются 6 последних реплик. Маршрут выбирает код по таблице R1–R7, а не модель</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_N1" associationDirection="None" sourceRef="N1" targetRef="Route" />
    <bpmn:textAnnotation id="N2">
      <bpmn:text>Ответ без проверяемой ссылки клиенту не уходит (G2)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_N2" associationDirection="None" sourceRef="N2" targetRef="Merge" />
    <bpmn:textAnnotation id="N3">
      <bpmn:text>При self-harm: сочувствие и номер 112 (R3)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_N3" associationDirection="None" sourceRef="N3" targetRef="Notify" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_ToBe">
    <bpmndi:BPMNPlane id="Plane_Process_ToBe" bpmnElement="Collab_ToBe">
      <bpmndi:BPMNShape id="Client_di" bpmnElement="Client" isHorizontal="true"><dc:Bounds x="80" y="30" width="1480" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ContactCenter_di" bpmnElement="ContactCenter" isHorizontal="true"><dc:Bounds x="80" y="130" width="1480" height="580" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Bot_di" bpmnElement="Lane_Bot" isHorizontal="true"><dc:Bounds x="110" y="130" width="1450" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Operator_di" bpmnElement="Lane_Operator" isHorizontal="true"><dc:Bounds x="110" y="550" width="1450" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="152" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="325" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Triage_di" bpmnElement="Triage"><dc:Bounds x="220" y="260" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Route_di" bpmnElement="Route" isMarkerVisible="true"><dc:Bounds x="395" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="430" y="330" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tmpl_di" bpmnElement="Tmpl"><dc:Bounds x="540" y="150" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TmplEnd_di" bpmnElement="TmplEnd"><dc:Bounds x="742" y="172" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="750" y="215" width="56" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Search_di" bpmnElement="Search"><dc:Bounds x="540" y="260" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="KB_di" bpmnElement="KB"><dc:Bounds x="575" y="380" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="545" y="435" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gen_di" bpmnElement="Gen"><dc:Bounds x="720" y="260" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Guard_di" bpmnElement="Guard" isMarkerVisible="true"><dc:Bounds x="915" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="890" y="250" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Answer_di" bpmnElement="Answer"><dc:Bounds x="1040" y="260" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnsEnd_di" bpmnElement="AnsEnd"><dc:Bounds x="1222" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1215" y="325" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" isMarkerVisible="true"><dc:Bounds x="915" y="465" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify"><dc:Bounds x="1300" y="450" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Operator_di" bpmnElement="Operator"><dc:Bounds x="1300" y="590" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OpEnd_di" bpmnElement="OpEnd"><dc:Bounds x="1482" y="612" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1470" y="655" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N1_di" bpmnElement="N1"><dc:Bounds x="220" y="150" width="175" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N2_di" bpmnElement="N2"><dc:Bounds x="990" y="380" width="160" height="45" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N3_di" bpmnElement="N3"><dc:Bounds x="1160" y="380" width="150" height="45" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="188" y="300" /><di:waypoint x="220" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="340" y="300" /><di:waypoint x="395" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="420" y="275" /><di:waypoint x="420" y="190" /><di:waypoint x="540" y="190" /><bpmndi:BPMNLabel><dc:Bounds x="428" y="205" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="445" y="300" /><di:waypoint x="540" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="450" y="265" width="84" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="420" y="325" /><di:waypoint x="420" y="490" /><di:waypoint x="915" y="490" /><bpmndi:BPMNLabel><dc:Bounds x="428" y="450" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="660" y="190" /><di:waypoint x="742" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="660" y="300" /><di:waypoint x="720" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="840" y="300" /><di:waypoint x="915" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="965" y="300" /><di:waypoint x="1040" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="990" y="282" width="14" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="940" y="325" /><di:waypoint x="940" y="465" /><bpmndi:BPMNLabel><dc:Bounds x="948" y="385" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1160" y="300" /><di:waypoint x="1222" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="965" y="490" /><di:waypoint x="1300" y="490" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1360" y="530" /><di:waypoint x="1360" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1420" y="630" /><di:waypoint x="1482" y="630" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="170" y="90" /><di:waypoint x="170" y="282" /><bpmndi:BPMNLabel><dc:Bounds x="178" y="105" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M2_di" bpmnElement="M2"><di:waypoint x="600" y="150" /><di:waypoint x="600" y="90" /><bpmndi:BPMNLabel><dc:Bounds x="608" y="105" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M3_di" bpmnElement="M3"><di:waypoint x="1100" y="260" /><di:waypoint x="1100" y="90" /><bpmndi:BPMNLabel><dc:Bounds x="1108" y="105" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M4_di" bpmnElement="M4"><di:waypoint x="1360" y="450" /><di:waypoint x="1360" y="90" /><bpmndi:BPMNLabel><dc:Bounds x="1282" y="105" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M5_di" bpmnElement="M5"><di:waypoint x="1420" y="610" /><di:waypoint x="1450" y="610" /><di:waypoint x="1450" y="90" /><bpmndi:BPMNLabel><dc:Bounds x="1458" y="105" width="54" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_N1_di" bpmnElement="Assoc_N1"><di:waypoint x="300" y="230" /><di:waypoint x="405" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_N2_di" bpmnElement="Assoc_N2"><di:waypoint x="990" y="425" /><di:waypoint x="955" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_N3_di" bpmnElement="Assoc_N3"><di:waypoint x="1235" y="425" /><di:waypoint x="1300" y="455" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Search_di" bpmnElement="DIA_Search"><di:waypoint x="600" y="380" /><di:waypoint x="600" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
